# Único modelo versionado de variáveis da web. Valores reais nunca vêm aqui:
#   - desenvolvimento: copie para .env (o Next lê .env e .env.development);
#   - staging e produção: aba Environment da Application no Dokploy
#     (docs/deploy.md). A imagem é UMA só, construída uma vez e
#     promovida de staging para produção (decisão 12.2): tudo o que muda entre
#     os ambientes é lido pelo servidor em tempo de execução, nada no build.
#     Cada variável, com valor por ambiente: docs/variaveis-de-ambiente.md.
#
# Sem NEXT_PUBLIC_: o Next embute no build todo valor com esse prefixo, e a
# imagem de staging levaria os valores de staging para produção. A única
# exceção é NEXT_PUBLIC_BUILD_SHA, que o Dockerfile gera a partir do commit
# (é o mesmo em qualquer ambiente). O servidor confere as variáveis ao subir
# (src/instrumentation.ts) e não inicia se faltar alguma obrigatória, com a
# lista do que corrigir no log.

NODE_ENV="development"

# Qual implantação é esta: development, staging ou production. Em staging o
# site responde robots com noindex. Obrigatória na Application de staging e
# na de produção.
APP_ENV="development"

# URL canônica do site (obrigatória em produção). No build entra a de
# produção (secret METADATA_BASE do GitHub): as páginas pré-renderizadas a
# imprimem nos canonicals, e staging não é indexado.
METADATA_BASE="http://localhost:3000"

# URL da API usada pelo SERVIDOR da web (pode ser um endereço interno).
HTTP_REQUEST="http://localhost:3333"

# URL da API usada pelo NAVEGADOR (obrigatória; substitui
# NEXT_PUBLIC_HTTP_REQUEST). Lida em tempo de execução e entregue à página.
PUBLIC_API_URL="http://localhost:3333"

# Opcional. Endereço do Socket.IO quando não é o da API. Vazio = PUBLIC_API_URL.
PUBLIC_SOCKET_URL=""

# Segredo compartilhado com a API (mesmo valor de RATE_LIMIT_FORWARDER_SECRET
# lá; mínimo 32 caracteres). Login, 2FA, recuperação de senha, refresh e
# rastreio público chamam a API a partir DESTE servidor; com o segredo, a API
# conta cada navegador pelo próprio endereço em vez de todos pelo deste
# servidor. Nunca prefixe com NEXT_PUBLIC_.
RATE_LIMIT_FORWARDER_SECRET=""

# Opcional. Origens de onde o navegador envia e baixa arquivos (URLs
# pré-assinadas), separadas por vírgula, para a Content-Security-Policy do
# middleware. Vazio = https://*.r2.cloudflarestorage.com (o bucket R2).
CSP_STORAGE_ORIGINS=""

# Turnstile (captcha do login, da recuperação de senha e do orçamento).
# Obrigatórias em produção; em desenvolvimento o captcha não aparece.
# TURNSTILE_SITE_KEY substitui NEXT_PUBLIC_TURNSTILE_SITE_KEY e vai para a
# página em tempo de execução; a secreta fica só no servidor.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Mapa de fundo da torre, da página da rota e do seletor de local (decisão
# 7.4). Modelo do Leaflet em https com {z}, {x} e {y} ({s} opcional), por
# exemplo https://{s}.provedor.com/{z}/{x}/{y}.png?key=... A atribuição é
# texto simples (HTML não é interpretado), como o provedor exige. Vazio: em
# desenvolvimento usa o OpenStreetMap público; em staging e produção o mapa
# fica sem fundo e a tela avisa (o OSM público não aceita carga comercial).
MAP_TILE_URL=""
MAP_TILE_ATTRIBUTION=""
# Opcional (decisão 16.123): o estilo ESCURO do mesmo provedor (ou de outro),
# usado enquanto o tema está escuro e trocado na hora, sem recarregar. Mesmo
# formato da MAP_TILE_URL; o host entra sozinho na CSP. A atribuição, se
# vazia, repete a MAP_TILE_ATTRIBUTION. Vazio: o mapa claro é recolorido por
# um filtro CSS (água azul, parques verdes), que funciona com qualquer
# provedor mas não é tão nítido quanto um estilo escuro de verdade.
# Exemplos: Stadia "alidade_smooth_dark", MapTiler "dataviz-dark"/"streets-v2-dark",
# CARTO "dark_all" (com contrato comercial).
MAP_TILE_URL_DARK=""
MAP_TILE_ATTRIBUTION_DARK=""

# Decisão 7.3: "true" tira o aviso da torre de que só aparece motorista com o
# app aberto. Ligue junto com o EXPO_PUBLIC_BACKGROUND_TRACKING do app, só
# depois da declaração de localização em segundo plano no Play Console.
BACKGROUND_TRACKING=""

# --- Só em staging e produção (aba Environment da Application) -----------
# Teto de heap do Node. Fica abaixo do limite de memória da Application
# (Advanced → Resources, 768 MiB); suba os dois juntos (docs/deploy.md, 6.4).
# Em dev fica vazia.
# NODE_OPTIONS=--max-old-space-size=512
