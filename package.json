    "lint:fix": "prettier --write .",
    "test": "playwright test",
    "test:unit": "vitest run --dir tests/unitaires",
    "test:unit:coverage": "vitest run --dir tests/unitaires --coverage",
    "test:mutation": "stryker run",
    "test:unit:watch": "vitest --dir tests/unitaires",
    "test:rules": "playwright test --project=chromium --reporter=list",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
