{
  "name": "trajetto-ui",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Front-end do Trajetto (Next.js App Router): painel dos módulos Frotas e Entregas (dashboard da empresa e /admin da equipe Trajetto), perfis de acesso e verificação em duas etapas, site público com blog e páginas legais em MDX e o portal de documentação da API (/docs). Consome a trajetto-api.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
